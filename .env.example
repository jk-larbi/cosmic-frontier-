# COSMIC FRONTIER — Server Environment Variables Example
# NASA Space Apps Challenge 2026

# Server configuration
PORT=3001
NODE_ENV=development

# Server-Side Google Gemini API Key for COSMIC AI GUIDE
# Read strictly on the server backend; NEVER exposed to the frontend or browser.
# Leave blank to run the COSMIC AI GUIDE in verified educational offline/demonstration mode.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model identifier (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
